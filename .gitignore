node_modules/
dist/
dist-single/
*.tsbuildinfo
.DS_Store

# Kept out of the published repository. The rules that matter to someone
# reading or running this are in README.md; these two are how the people who
# maintain it work, which is not the reader's concern.
CONVENTIONS.md
INTERNAL.md

# Automation is configured outside the published repository.
.github/workflows/

# Deployment and release scripts. Same reason: how this is hosted and released
# is not part of what the repository publishes. Keep local/ for anything that
# should stay on your machine.
#
# scripts/ is covered too, because that is where they are actually kept, and
# release.sh stages the whole tree before it commits: an unignored copy would
# publish itself, and the project name with it, on the next release.
local/
scripts/*.sh
