# Cloudflare Pages header rules.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # Everything is bundled and served from this origin. The two font hosts are
  # the only external origins; static.cloudflareinsights.com is listed so
  # Cloudflare Web Analytics works the moment it is switched on in the
  # dashboard, without a redeploy.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Asset filenames carry a content hash, so they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must revalidate, or a deploy never reaches returning users.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
