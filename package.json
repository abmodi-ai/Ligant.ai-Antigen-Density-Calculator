{
  "name": "antigen-density-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flow cytometry MFI to molecules-per-cell (ABC) calculator for CAR-T antigen density quantification",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.config.single.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:style": "node scripts/check-style.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:network": "node scripts/check-network.mjs",
    "verify": "npm run check:style && npm run check:privacy && tsc -b && npm test && npm run build && npm run check:network"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
